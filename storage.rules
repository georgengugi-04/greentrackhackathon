rules_version = '2';

// GreenTrack Storage rules. This file has never existed in the project
// before — meaning Storage has been running on whatever default the
// Firebase project started with (usually a fully-locked-down deny-all,
// which is why farm_documents/** uploads have been silently failing:
// the code catches the permission error and continues without a photo
// rather than crashing, so the document itself still saves and the
// failure looks invisible unless you're watching for it).
service firebase.storage {
  match /b/{bucket}/o {

    // Batch photos — the farmer logging a crop batch. Readable by anyone
    // signed in (QR trace needs to show the photo to a chef/diner who
    // scans it), writable only while signed in. Ownership isn't checked
    // at the Storage layer here because the matching Firestore doc
    // already enforces who's allowed to touch batch/{batchId} — Storage
    // just needs "you're a real signed-in user," not "you own this exact
    // batch," since the path itself isn't guessable without already
    // having a legitimate batchId.
    match /batches/{batchId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Fertilizer/pesticide bottle photos, organic certificates, etc.
    // This is the path that's been missing coverage.
    match /farm_documents/{docId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Chef meal photos.
    match /meals/{mealId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Profile photos — scoped to the user's own uid folder specifically,
    // since there's no separate Firestore doc gating this one.
    match /users/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Everything else stays denied by default (no catch-all rule below
    // this point) — matches the same deny-by-default posture as
    // firestore.rules.
  }
}
